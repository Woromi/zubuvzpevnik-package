\RequirePackage{import}
\RequirePackage[czech]{babel}
\RequirePackage{etoolbox}
\RequirePackage{xpatch}
\RequirePackage{ifthen}
\RequirePackage{fontspec}
\RequirePackage[default]{opensans}
\RequirePackage{roboto-mono}
\RequirePackage{relsize}
\RequirePackage[linktoc=all]{hyperref}
\RequirePackage{calc}

% ==========================
% Internal defaults (overridable by class)
% ==========================
\newcommand{\zub@lyricfont}{}
\newcommand{\zub@printchord}{}
\newcommand{\zub@stitlefont}{}
\newif\iflargepaper
\largepaperfalse % default (A5 or smaller)

% Hook up to songs package
\renewcommand{\lyricfont}{\zub@lyricfont}
\renewcommand{\printchord}{\zub@printchord}
\renewcommand{\stitlefont}{\zub@stitlefont}
\renewcommand{\notefont}{\it}

% ==========================
% Index setup
% ==========================
\newindex{obsah}{obsah/obsah}
\indexsongsas{obsah}{\thepage}
\newauthorindex{obsahAutor}{obsah/obsahAutor}
\indexsongsas{obsahAutor}{\thepage}

