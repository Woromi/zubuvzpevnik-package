\baselineadj=2pt plus 2.5pt minus 0.5pt
\renewcommand{\clineparams}{
	\baselineskip=10pt
	\lineskiplimit=0.5pt
	\lineskip=0.5pt
}
\versesep=12pt plus 2pt minus 6pt
\spenalty=-10000 % Pisnicka na nove strance
\setlength{\sbarheight}{0pt} % Odstraneni vodorovne cary pred a za pisnickou
\setlength{\songnumwidth}{0cm} % Zrusi cislovani pisnicek

% ==========================
% Environments
% ==========================

\newcommand{\smalleronsmallpage}[1][0.5]{%
	\iflargepaper\else\smaller[#1]\fi
}

\newcommand{\chordsoffonsmallpage}{%
	\iflargepaper\else\chordsoff\fi
}

\newenvironment{narrowonlargepaper}{%
	\iflargepaper
		\par\noindent
		\begin{minipage}{0.8\linewidth}% adjust 0.8 to your desired width fraction
	\fi
}{%
	\iflargepaper
		\end{minipage}%
	\fi
}

\newcommand{\narrowtextnote}[1]{%
	\begin{narrowonlargepaper}
		\textnote{#1}
	\end{narrowonlargepaper}
}

\newcommand{\narrowlilypondfile}[1]{%
	\begin{narrowonlargepaper}
		\lilypondfile{#1}
	\end{narrowonlargepaper}
}

% ==========================
% Page padding
% ==========================
% Blank pages until the document is a multiple of #1 pages, counted from the
% page the class started numbering at. #2 runs on each blank page. Both A5
% classes wrap it -- the book to finish a sheet of paper, the booklet to finish
% an imposition unit; see docs/internals.md.
\newcounter{ZUB@fillpages}
\newcommand{\zub@padpages}[2]{%
	\clearpage
	% \value{page} is the page about to be set, so one less is what is done.
	% \divide truncates, which is what makes this the remainder.
	\@tempcnta\value{page}\advance\@tempcnta\m@ne
	\@tempcntb\@tempcnta \divide\@tempcntb by #1\relax \multiply\@tempcntb by #1\relax
	\advance\@tempcnta-\@tempcntb
	\ifnum\@tempcnta>\z@
		\setcounter{ZUB@fillpages}{\numexpr#1-\@tempcnta\relax}%
	\else
		\setcounter{ZUB@fillpages}{0}%
	\fi
	\loop
	\ifnum\value{ZUB@fillpages}>0
		#2\null\newpage
		\addtocounter{ZUB@fillpages}{-1}%
	\repeat
}

