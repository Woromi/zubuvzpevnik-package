% ==========================
% Czech chords (H = English B, B = English B-flat)
% ==========================
% The songs package only supports 7 note names, but the Czech system has an
% eighth one: B means English B-flat. Patch the transposition scanner so that
%  - input: a note name matching none of the seven \notenames is compared
%    against \ZUB@noteBb and read as B-flat (semitone 1),
%  - output: semitone 1 prints \ZUB@printBb instead of \printnoteB\flt,
%    so with Czech names it prints "B" rather than the nonsense "Hb".
\newcommand\ZUB@noteBb{\relax}% never matches a note name => disabled
\newcommand\ZUB@printBb{\printnoteB\noexpand\flt}

\patchcmd\SB@trtrans
	{\else-99 \fi}
	{\else\ifx\SB@temp\ZUB@noteBb\@ne\else-99 \fi\fi}
	{}{\PackageError{zubuvzpevnik}{Patching \string\SB@trtrans\space (note input) failed}{}}
\patchcmd\SB@trtrans
	{\printnoteB\noexpand\flt\or\printnoteB\or}
	{\ZUB@printBb\or\printnoteB\or}
	{}{\PackageError{zubuvzpevnik}{Patching \string\SB@trtrans\space (note output) failed}{}}

\newcommand{\englishchords}{%
	\notenames{A}{B}{C}{D}{E}{F}{G}%
	\def\ZUB@noteBb{\relax}%
	\def\ZUB@printBb{\printnoteB\noexpand\flt}%
}

\newcommand{\czechchords}{%
	\notenames{A}{H}{C}{D}{E}{F}{G}%
	\def\ZUB@noteBb{B}%
	\def\ZUB@printBb{B}%
}

% Write a "%lang <language>" directive line before each song's index entries
% so that songidx.lua can apply per-language title rules (e.g. rotating the
% English articles The/A/An while leaving the Czech conjunction "A" alone).
% \@percentchar is the kernel's category-12 "%", written out literally.
\xpatchcmd{\SB@addtoindex}
	{\SB@cwrite{#1}{#2}}
	{\SB@cwrite{#1}{\@percentchar lang \SB@songlang}\SB@cwrite{#1}{#2}}
	{}{\PackageError{zubuvzpevnik}{Patching \string\SB@addtoindex\space (lang directive) failed}{}}

% ==========================
% Song metadata (key, tuning)
% ==========================
\newcommand{\key}{}
\newsongkey{key}{\def\key{}}{\def\key{\small \bfseries{Key}: {\mdseries#1}\par}}

\newcommand{\tuning}{}
\newsongkey{tun}{\def\tuning{}}{\def\tuning{\small \bfseries{Tuning}: {\mdseries#1}\par}}

\newcommand{\tempo}{}
\newsongkey{tem}{\def\tempo{}}{\def\tempo{\small \bfseries{Tempo}: {\mdseries#1}\par}}

\newcommand{\original}{}
\newsongkey{ori}{\def\original{}}{\def\original{\small \bfseries{Original}: {\mdseries#1}\par}}

\newcommand{\usedchords}{}
\newsongkey{chr}{\def\usedchords{}}{\def\usedchords{#1\par}}

\newcommand{\SB@songlang}{}
\newsongkey{lang}
{\gdef\SB@songlang{}\selectlanguage{english}\englishchords}%
{\gdef\SB@songlang{#1}\selectlanguage{#1}%
	\ifthenelse{\equal{#1}{czech}\OR\equal{#1}{slovak}}{\czechchords}{\englishchords}
}

\newcommand{\sourcelink}{}
\newsongkey{src}{\def\sourcelink{}}{\def\sourcelink{\url{#1}\par}}

\renewcommand{\extendprelude}{{%
			\usedchords
			\showrefs
			\original
			\tempo
			\tuning
			\key
		}}

\renewcommand\makeprelude{%
	\resettitles
	{\Large\bfseries\songtitle\space\mdseries\smalleronsmallpage[1](\songauthors)}%
	\iflargepaper
		\hfill
		\raisebox{0pt}[0pt][0pt]{%
			\makebox[0pt][r]{% Box nulové šířky zarovnaný doprava
				\parbox[t]{7cm}{% Box s textem
					\raggedleft % Zarovnání textu uvnitř boxu doprava
					\extendprelude % Metadata
				}%
			}%
		}%
	\fi
}

% ==========================
% Filter songs by language
% ==========================
% \providecommand: build.sh may have already defined these on the command line
\providecommand\ZUB@includelangs{}
\providecommand\ZUB@excludelangs{}

\newcommand\includelangs[1]{\renewcommand\ZUB@includelangs{#1}}
\newcommand\excludelangs[1]{\renewcommand\ZUB@excludelangs{#1}}

\let\SB@origsubmitsong\SB@submitsong
\renewcommand\SB@submitsong{%
  \ifthenelse{\equal{\ZUB@includelangs}{}}{%
    \ifthenelse{\equal{\ZUB@excludelangs}{}}{%
      \SB@origsubmitsong
    }{%
      \IfSubStr{\ZUB@excludelangs}{\SB@songlang}{%
        \setbox\SB@songbox\box\voidb@x\addtocounter{songnum}{-1}%
      }{%
        \SB@origsubmitsong
      }%
    }%
  }{%
    \IfSubStr{\ZUB@includelangs}{\SB@songlang}{%
      \SB@origsubmitsong
    }{%
      \setbox\SB@songbox\box\voidb@x\addtocounter{songnum}{-1}%
    }%
  }%
}

% ==========================
% Environments
% ==========================

\newcommand{\smalleronsmallpage}[1][0.5]{%
	\iflargepaper\else\smaller[#1]\fi
}

\newenvironment{narrowonlargepaper}{%
	\iflargepaper
		\par\noindent
		\begin{minipage}{0.8\linewidth}% adjust 0.8 to your desired width fraction
	\fi
}{%
	\iflargepaper
		\end{minipage}%
	\fi
}

\newcommand{\narrowtextnote}[1]{%
	\begin{narrowonlargepaper}
		\textnote{#1}
	\end{narrowonlargepaper}
}

\newcommand{\narrowlilypondfile}[1]{%
	\begin{narrowonlargepaper}
		\lilypondfile{#1}
	\end{narrowonlargepaper}
}

