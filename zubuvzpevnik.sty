% ==========================
% LilyPond include path
% ==========================
% Lets fragments \include "zubuvzpevnik.ily" by bare name; see docs/internals.md.
\directlua{
  local sty = kpse.find_file("zubuvzpevnik.sty")
  if sty then
    local dir = sty:match("(.*/)") .. "lilypond"
    local cur = lua_options.get_option("ly", "includepaths") or ""
    lua_options.set_option("ly", "includepaths",
      cur == "" and dir or cur .. "," .. dir)
  end
}

% ==========================
% LilyPond note names
% ==========================
% Czech and Slovak songs get German note names, everything else English;
% see docs/internals.md#package-setup. Hidden under \chordsoff, like \musicnote.
\let\ZUB@lilypondfile\lilypondfile
% A song re-shaped by \transposesong adds the options that transpose its score
% (feature/transpozice.cfg).
\newcommand{\zub@lyopts}{}
\renewcommand{\lilypondfile}[1]{%
	\ifchorded
		\IfSubStr{,czech,slovak,}{,\SB@songlang,}%
			{\def\zub@lyopts{language=deutsch}}%
			{\def\zub@lyopts{}}%
		\zub@tr@lyopts{#1}%
		\ifx\zub@lyopts\@empty
			\ZUB@lilypondfile{#1}%
		\else
			\expandafter\ZUB@lilypondfile\expandafter[\zub@lyopts]{#1}%
		\fi
	\fi
}

% ==========================
% LilyPond spacing
% ==========================
% Air around an engraved score, which lyluatex leaves to these two hooks; see
% docs/internals.md#package-setup.
\newcommand{\zub@lilypondsep}{\medskipamount}
\newcommand{\preLilyPondExample}{\par\addvspace{\zub@lilypondsep}}
\newcommand{\postLilyPondExample}{\par\addvspace{\zub@lilypondsep}}

% ==========================
% Fonts
% ==========================
% Glyphs a font lacks (kana, kanji) come from Noto Sans CJK JP; see
% docs/internals.md#scripts-without-a-font.
% Without the font the chain points back at Open Sans: a fallback that cannot
% load takes every font down with it.
\RequirePackage{fontspec}% \IfFontExistsTF; babel would load it anyway
\IfFontExistsTF{Noto Sans CJK JP}%
	{\def\zub@fallbackfont{Noto Sans CJK JP}}%
	{\def\zub@fallbackfont{Open Sans}%
	 \PackageWarningNoLine{zubuvzpevnik}{Noto Sans CJK JP not found; Japanese
		and Chinese characters will not print}}
\directlua{luaotfload.add_fallback("zubfallback", {"\zub@fallbackfont:mode=node;"})}
\babelfont{rm}[RawFeature={fallback=zubfallback}]{Open Sans}
\babelfont{sf}[RawFeature={fallback=zubfallback}]{Open Sans}
% HyphenChar: fontspec loads a monospaced font with hyphenation off, and lyrics
% are set in tt -- so without it nothing hyphenates and songs' chord-split hyphen
% (\[C]lo\[G/B]ne\[Am]ly) is never drawn. It belongs to the family, so it holds
% at every size and in every language, which is where hyphenat's htt option --
% what stood here -- fell short. See docs/internals.md#package-setup.
% The "XeTeX-only feature" warning fontspec prints for HyphenChar is wrong on
% LuaTeX -- its own LuaTeX branch applies the value -- so it is silenced. Not
% just around the declaration below: babel builds the tt family again for each
% language, lazily, so most of the warnings land mid-document. HyphenChar is the
% only such feature the repo uses, so nothing real is being hidden.
\ExplSyntaxOn
\msg_redirect_name:nnn { fontspec } { only-xetex-feature } { none }
\ExplSyntaxOff
\babelfont{tt}[HyphenChar={-},RawFeature={fallback=zubfallback}]{Roboto Mono}
\babelfont[hebrew]{rm}{FreeSans}

% ==========================
% Internal defaults (overridable by class)
% ==========================
\newcommand{\zub@lyricfont}{\ttfamily}
\newcommand{\zub@printchord}{\ttfamily}
\newcommand{\zub@stitlefont}{}
\newcommand{\zub@meterfont}{\ttfamily}
\newcommand{\zub@repfont}{\bfseries}
% A repeat count is read, not sung, so it is set like a chord rather than like
% the lyric it trails. The times sign is the body font's, not songs.sty's cmsy
% one, which has no bold. See docs/internals.md#chords-akordycfg.
\renewcommand{\rep}[1]{({\zub@repfont\symbol{"00D7}#1})}

\newif\iflargepaper
\largepaperfalse % default (A5 or smaller)
% Paper this book is typeset on, matched against each song's pap key
% (feature/metadata.cfg). Read off the page the class actually set, so the name
% cannot drift from the paper option passed to \LoadClass. Add a \zub@paperis
% line for a new size.
\newcommand{\zub@papername}{}
\newif\ifzub@paperknown
\newcommand{\zub@paperis}[3]{%
	\ifdim\paperwidth=#2\relax\ifdim\paperheight=#3\relax
		\renewcommand{\zub@papername}{#1}\zub@paperknowntrue
	\fi\fi
}
% At begin-document, so geometry has had its say about the page.
\AtBeginDocument{%
	\zub@paperis{a4}{210mm}{297mm}%
	\zub@paperis{a5}{148mm}{210mm}%
	\ifzub@paperknown\else
		\PackageWarning{zubuvzpevnik}{Unrecognised paper \the\paperwidth\space by
			\the\paperheight, so no song's pap key can be checked against it. Add a
			\string\zub@paperis\space line for this size}%
	\fi
}

% Hook up to songs package
\renewcommand{\lyricfont}{\zub@lyricfont}
