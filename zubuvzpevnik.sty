\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{zubuvzpevnik}[2025-08-22 Úprava songs balíčku tak, aby vypadal jako Zubův zpěvník]

% ==========================
% Options
% ==========================
\DeclareOption*{%
	\PassOptionsToPackage{\CurrentOption}{songs}%
}
\ProcessOptions\relax

% ==========================
% Required packages
% ==========================
\RequirePackage{songs}
\RequirePackage{import}
\RequirePackage[english,czech]{babel}
\RequirePackage[autostyle=true]{csquotes}
\RequirePackage{etoolbox}
\RequirePackage{xpatch}
\RequirePackage{ifthen}
\RequirePackage{relsize}
\RequirePackage[linktoc=all]{hyperref}
\RequirePackage{bookmark}
\RequirePackage{calc}
\RequirePackage[fragment=false,pass-fonts,language=Czech]{lyluatex}
\RequirePackage[htt]{hyphenat}

% ==========================
% Fonts
% ==========================
\babelfont{rm}{Open Sans}
\babelfont{sf}{Open Sans}
\babelfont{tt}{Roboto Mono}
\babelfont[hebrew]{rm}{FreeSans}

% ==========================
% Quotes fix
\DeclareQuoteAlias{czech}{quotes}
\renewcommand{\uv}[1]{\enquote{#1}}

% ==========================
% Internal defaults (overridable by class)
% ==========================
\newcommand{\zub@lyricfont}{\ttfamily}
\newcommand{\zub@printchord}{\ttfamily}
\newcommand{\zub@stitlefont}{}
\newcommand{\zub@meterfont}{\ttfamily}
\newif\iflargepaper
\largepaperfalse % default (A5 or smaller)

% Hook up to songs package
\renewcommand{\lyricfont}{\zub@lyricfont}
\renewcommand{\printchord}{\zub@printchord}
\renewcommand{\stitlefont}{\zub@stitlefont}
\renewcommand{\meterfont}{\zub@meterfont}
\renewcommand{\notefont}{\it}

% ==========================
% Index setup
% ==========================
\newindex{obsah}{obsah}
\indexsongsas{obsah}{\thepage}
\newauthorindex{obsahAutor}{obsahAutor}
\indexsongsas{obsahAutor}{\thepage}

% ==========================
% Layout inside songs
% ==========================
\baselineadj=2pt plus 2.5pt minus 0.5pt
\renewcommand{\clineparams}{
	\baselineskip=10pt
	\lineskiplimit=0.5pt
	\lineskip=0.5pt
}
\versesep=12pt plus 2pt minus 6pt
\spenalty=-10000 % Pisnicka na nove strance
\setlength{\sbarheight}{0pt} % Odstraneni vodorovne cary pred a za pisnickou
\setlength{\songnumwidth}{0cm} % Zrusi cislovani pisnicek

% ==========================
% Capo
% ==========================
\renewcommand\capo[1]{%
	\iftranscapos
		\transpose{#1}%
	\else
		\vspace{-1em}\musicnote{\textit{Capo #1}}%
	\fi
}

% ==========================
% TODO: Czech chords
% ==========================

% Definice notových systémů
\newcommand{\englishchords}{%
	% Anglický systém: C D E F G A B
	\notenames{A}{B}{C}{D}{E}{F}{G}%
	% Křížky a béčka standardně
}

\newcommand\czechchords{%
	\notenames{A}{H}{C}{D}{E}{F}{G}%
}

% ==========================
% Song metadata (key, tuning)
% ==========================
\newcommand{\key}{}
\newsongkey{key}{\def\key{}}{\def\key{\small \bfseries{Key}: {\mdseries#1}\par}}

\newcommand{\tuning}{}
\newsongkey{tun}{\def\tuning{}}{\def\tuning{\small \bfseries{Tuning}: {\mdseries#1}\par}}

\newcommand{\tempo}{}
\newsongkey{tem}{\def\tempo{}}{\def\tempo{\small \bfseries{Tempo}: {\mdseries#1}\par}}

\newcommand{\original}{}
\newsongkey{ori}{\def\original{}}{\def\original{\small \bfseries{Original}: {\mdseries#1}\par}}

\newcommand{\usedchords}{}
\newsongkey{chr}{\def\usedchords{}}{\def\usedchords{#1\par}}

\newsongkey{lang}{\selectlanguage{english}}{
	\selectlanguage{#1}
	\ifthenelse{\equal{#1}{czech}}{
		\czechchords
	}{
		\englishchords
	}
}

\newcommand{\sourcelink}{}
\newsongkey{src}{\def\sourcelink{}}{\def\sourcelink{\url{#1}\par}}

\renewcommand{\extendprelude}{{%
			\usedchords
			\showrefs
			\original
			\tempo
			\tuning
			\key
		}}

\renewcommand\makeprelude{%
	\resettitles
	{\Large\bfseries\songtitle\space\mdseries\smalleronsmallpage[1](\songauthors)}%
	\iflargepaper
		\hfill
		\raisebox{0pt}[0pt][0pt]{%
			\makebox[0pt][r]{% Box nulové šířky zarovnaný doprava
				\parbox[t]{7cm}{% Box s textem
					\raggedleft % Zarovnání textu uvnitř boxu doprava
					\extendprelude % Metadata
				}%
			}%
		}%
	\fi
}

% ==========================
% Environments
% ==========================

\newcommand{\smalleronsmallpage}[1][0.5]{%
	\iflargepaper\else\smaller[#1]\fi
}

\newenvironment{narrowonlargepaper}{%
	\iflargepaper
		\par\noindent
		\begin{minipage}{0.8\linewidth}% adjust 0.8 to your desired width fraction
	\fi
}{%
	\iflargepaper
		\end{minipage}%
	\fi
}

\newcommand{\narrowtextnote}[1]{%
	\begin{narrowonlargepaper}
		\textnote{#1}
	\end{narrowonlargepaper}
}

\newcommand{\narrowlilypondfile}[1]{%
	\begin{narrowonlargepaper}
		\lilypondfile{#1}
	\end{narrowonlargepaper}
}

% ==========================
% Chord diagram patches
% ==========================
% change barre position size and font to mono
\patchcmd{\SB@fretnum}
{\sffamily\fontsize\@xpt\@xpt\selectfont#1}
{\ttfamily\small#1}{}{}

\patchcmd{\SB@topempty}
{\relax}
{{\vrule\@width\z@\@height4.3333\p@\@depth.8333\p@}}{}{}


% ==========================
% Song parts
% ==========================

\import{songpart/}{sloka.cfg}
% Changed chorus environment to look more like a verse with 'R:'
\import{songpart/}{refren.cfg}
% Chords only songpart. The chords have a fixed width
\import{songpart/}{instrumental.cfg}
% Indexing song titles with authors
\import{songpart/}{index.cfg}

% Multi-voice support
\import{songpart/}{voices.cfg}

\endinput
